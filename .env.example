# AI Accounts Assistant - Environment Configuration

# Claude API (required)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Claude model (optional, defaults to claude-sonnet-4-20250514)
# CLAUDE_MODEL=claude-opus-4-20250514

# Teleos MCP Server
MCP_HOST=localhost
MCP_PORT=3000
MCP_API_KEY=your-mcp-api-key-here

# Flask settings
FLASK_PORT=5003
SECRET_KEY=generate-a-secure-random-key-here

# Teleos direct MySQL (read-only, for shared teleos_read module)
TELEOS_MYSQL_HOST=192.168.x.x
TELEOS_MYSQL_PORT=3306
TELEOS_MYSQL_USER=readonly_user
TELEOS_MYSQL_PASSWORD=password
TELEOS_MYSQL_DATABASE=teleos_live
